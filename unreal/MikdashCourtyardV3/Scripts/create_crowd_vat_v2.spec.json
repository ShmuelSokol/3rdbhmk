{
  "specVersion": 1,
  "prepared": "2026-09-11",
  "purpose": "Bake the re-authored WalkV2 walk and the idle of six PilgrimRigV3 bodies into vertex animation textures (Epic AnimToTexture, Vertex mode, 16-bit) on decimated static meshes, and build the crowd VAT material, for AMikdashCrowdField. Creates NEW assets under the namespace below only; touches no map and no existing asset.",
  "projectDir": "C:\\Mikdash\\Working-5.8\\MikdashCourtyardV3",
  "namespace": "/Game/MikdashV3/Runtime/CrowdVATV1",
  "receiptFolder": "SourceAssets/runtime-review/crowd-field/vat-v2",
  "launch": "UnrealEditor.exe <uproject> /Engine/Maps/Entry -ExecutePythonScript=<this script> -unattended -nosplash -nullrhi -EnablePlugins=AnimToTexture,GeometryScripting -CrowdVatBake -abslog=<log>. AnimToTexture spawns a temporary SkeletalMeshComponent in GEditor's editor world, so this is the hidden-editor recipe, not the -run=pythonscript commandlet.",
  "whyTheseClips": "WalkV2 (Scripts/rewalk_pilgrim_v3.py, WALK-V2-RECEIPT.md): step 71.93-71.97 cm, ground speed 119.89-119.95 cm/s, planted-foot drift 0.019 cm offline and 0.053 cm in engine. NOT the old A_Pilgrim_Original_Walk under <variant>/SkeletalMeshes, which skated 4.40-4.57 cm per step.",
  "walk": {
    "expectedKeys": 73,
    "expectedLengthSec": 1.2,
    "loopFrames": 72,
    "sampleRateHz": 60.0,
    "groundSpeedCmPerSecAtRate1": 119.95,
    "stepCm": 71.97,
    "cycleDistanceCm": 143.94,
    "uvChannel": 1,
    "why": "73 keys at 60 fps over 1.2 s: key 72 is key 0 of the next cycle, so frames 0..71 are baked and the material wraps 71->0. SampleRate MUST equal the clip's own key rate: AnimationToTexture samples AnimNumFrames keys at 1/SampleRate spacing."
  },
  "idle": {
    "expectedKeys": 193,
    "expectedLengthSec": 3.2,
    "loopFrames": 192,
    "sampleRateHz": 60.0,
    "uvChannel": 2,
    "why": "Measured in engine 2026-09-11 (crowd-vat-bake-20260911T041922190802Z.json): the WalkV2 import re-exported the idle at 60 fps too, 193 keys over 3.2 s. Frames 0..191 are baked at 60 Hz; the material wraps 191->0."
  },
  "mesh": {
    "targetTriangles": 2400,
    "why": "The crowd lives at 30-200 m, where a figure is 10-60 px tall. The V1 statues were 1,228 triangles; the source bodies are 13-20k. 2,400 keeps the silhouette (arms, head cover, hem) for about twice the old triangle cost per figure.",
    "numDriverTriangles": 10,
    "sigma": 1.0,
    "precision": "SixteenBits",
    "maxTextureWidth": 4096
  },
  "meshYawOffsetDegrees": -90.0,
  "meshYawWhy": "PilgrimRigV3 bodies face UE +Y after the Interchange glTF frame swap (memory: pilgrim-v3-import-lessons); the crowd field's heading convention is local +X, so instance yaw = heading - 90.",
  "customData": {
    "count": 11,
    "layout": {
      "0": "walk phase at anchor (cycles, 0..1)",
      "1": "garment tint index/(N-1)",
      "2": "idle target (1 idle, 0 walk)",
      "3": "anchor game time T0 (s)",
      "4": "walk rate (cycles/s) = speed / (cycleDistance * scale)",
      "5": "velocity X (cm/s, world)",
      "6": "velocity Y",
      "7": "velocity Z",
      "8": "time of last walk/idle switch (s)",
      "9": "idle offset / per-figure variation hash (0..1)",
      "10": "extrapolation horizon (s)"
    }
  },
