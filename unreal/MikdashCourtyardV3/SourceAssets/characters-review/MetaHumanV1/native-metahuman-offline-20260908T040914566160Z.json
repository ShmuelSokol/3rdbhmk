    "consequencesIfMissing": [
      "Content/Optional/TextureSynthesis/TS-1.3-F_UE_res-1024_nchr-153 - the skin texture synthesis model. Without it CommitSkinSettings cannot synthesize skin, so every character keeps placeholder skin.",
      "Content/Optional/BodyTextures - body texture set.",
      "Content/Optional/Presets - the face/body preset library. Without it the Presets panel is empty and every new character starts on the same archetype face.",
      "Content/Optional/Grooms/Bindings/{Hair,Beards,Mustaches,Eyebrows,Eyelashes,Peachfuzz} - ALL hair. Two of the five characters here are specified as bearded and there is no shipped beard groom without this pack.",
      "Content/Optional/Clothing - the WI_* wardrobe items including WI_DefaultGarment.",
      "Content/Optional/Animation/TemplateAnimations and Optional/Animation/UEFNAnimPreset.",
      "Content/Optional/DCC - DCC export support.",
      "Content/Optional/Body/FixedCompatibility - the legacy fixed body types."
    ],
    "howToInstall": "Epic Games Launcher -> Unreal Engine -> Library -> the 5.8.2 slot's dropdown arrow -> Options -> tick 'MetaHuman Creator Core Data' -> Apply. It installs into the engine directory, not the project. Multi-GB; the editor prints the missing-content notification and a 'METAHUMAN CREATOR CORE DATA IS MISSING' viewport banner until it is there."
  },
  "cloud": {
    "note": "Two steps in the MetaHuman build are Epic cloud service calls, not local computation. Read from MetaHumanCharacterEditorSubsystem.cpp: RequestAutoRigging -> UE::MetaHuman::FAutoRigServiceRequest, RequestTextureSources -> the same FMetaHumanCharacterEditorCloudRequests holder.",
    "requiresEpicLogin": true,
    "loginTrigger": "MetaHuman Character Editor toolbar -> Authentication Menu. Its own tooltip says 'No user logged in, please autorig to trigger log-in flow', i.e. the first auto-rig starts the browser login.",
    "batchFlags": {
      "blocking": true,
      "reportProgress": false
    },
    "batchFlagsNote": "Both request structs expose bBlocking/bReportProgress; Epic's own example_auto_rig.py and example_download_textures.py comment them as 'Required for running in batch'.",
    "memoryWarning": "MetaHumanCharacterEditorToolkit.cpp refuses (with a confirm dialog) to auto-rig with blend shapes below 10 GiB FREE memory. This machine has 16 GB total, so the spec uses JOINTS_ONLY."
  },
  "build": {
    "pipelineType": "OPTIMIZED",
    "pipelineTypeEnum": "unreal.MetaHumanDefaultPipelineType (CINEMATIC='UE Cine (Complete)', OPTIMIZED='UE Optimized', UEFN='UEFN Export')",
    "pipelineQuality": "MEDIUM",
    "pipelineQualityEnum": "unreal.MetaHumanQualityLevel (CINEMATIC/HIGH/MEDIUM/LOW)",
    "rigType": "JOINTS_ONLY",
    "rigTypeEnum": "unreal.MetaHumanRigType (JOINTS_ONLY / JOINTS_AND_BLENDSHAPES)",
    "enableWardrobeItemValidation": true,
    "reason": "RTX 2070 / 16 GB. OPTIMIZED+MEDIUM is the quality tier Epic's own example_assembly.py uses; CINEMATIC keeps strand grooms and the full material stack and is not viable for a dozen on-screen characters on this GPU. JOINTS_ONLY avoids the 10 GiB blend-shape memory gate and removes the face blend-shape morph target memory, at the cost of facial expression fidelity - acceptable for background pilgrims, NOT acceptable if any character ever needs close-up facial performance."
  },
